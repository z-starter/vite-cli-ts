{
  "name": "vite-cli-ts",
  "version": "0.0.0",
  "type": "module",
  "main": "bin.js",
  "bin": "bin.js",
  "files": [
    "dist",
    "bin.js"
  ],
  "scripts": {
    "build": "tsc && vite build && yarn docs",
    "obfuscate": "javascript-obfuscator dist/index.js --output dist/index.js --compact true --control-flow-flattening true",
    "dev": "yarn build && ./bin.js",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch",
    "test": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@o.z/vite-plugin-swc": "^0.19.0",
    "@testing-library/user-event": "^14.6.6",
    "@types/inquirer": "^9.0.10",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.4.0",
    "@types/yargs": "^17.0.35",
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "^10.0.5",
    "glob": "^13.0.6",
    "javascript-obfuscator": "^5.6.0",
    "jsdom": "^30.0.1",
    "nodemon": "^3.1.14",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "packageManager": "yarn@4.18.0",
  "dependencies": {
    "inquirer": "^14.2.0",
    "yargs": "^18.1.0"
  }
}
