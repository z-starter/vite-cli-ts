{
  "name": "vite-cli-ts",
  "version": "0.0.0",
  "type": "module",
  "main": "bin.js",
  "bin": "bin.js",
  "files": [
    "dist",
    "bin.js"
  ],
  "scripts": {
    "build": "tsc && vite build && yarn docs",
    "obfuscate": "javascript-obfuscator dist/index.js --output dist/index.js --compact true --control-flow-flattening true",
    "dev": "yarn build && ./bin.js",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch",
    "test": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@o.z/vite-plugin-swc": "^0.7.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/inquirer": "^9.0.9",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^25.5.0",
    "@types/yargs": "^17.0.35",
    "@vitest/coverage-v8": "^4.1.1",
    "concurrently": "^9.2.1",
    "glob": "^13.0.6",
    "javascript-obfuscator": "^5.4.1",
    "jsdom": "^29.0.1",
    "nodemon": "^3.1.14",
    "typedoc": "^0.28.18",
    "typedoc-plugin-markdown": "^4.11.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.2",
    "vitest": "^4.1.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "packageManager": "yarn@4.13.0",
  "dependencies": {
    "inquirer": "^13.3.2",
    "yargs": "^18.0.0"
  }
}
